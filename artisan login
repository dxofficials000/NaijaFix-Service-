<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Artisan Login — NaijaFix</title>
<link rel="stylesheet" href="style.css">
<style>
  .auth-wrap {
    max-width: 400px;
    margin: 60px auto;
    padding: 24px;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 14px;
  }
  .auth-wrap h2 { margin-bottom: 1rem; }
  .auth-wrap input {
    width: 100%;
    padding: 12px;
    margin-bottom: 12px;
    border-radius: 8px;
    border: 1px solid var(--border-color);
    background: #0b0f17;
    color: #fff;
  }
  .auth-wrap button {
    width: 100%;
    padding: 12px;
    background: var(--green-primary);
    color: #fff;
    border: none;
    border-radius: 8px;
    font-weight: 700;
    cursor: pointer;
    margin-bottom: 10px;
  }
  .auth-toggle { text-align: center; color: var(--text-muted); font-size: 0.9rem; }
  .auth-toggle a { color: var(--green-primary); cursor: pointer; }
  #authMsg { color: #ff6b6b; font-size: 0.9rem; margin-bottom: 10px; min-height: 1.2em; }
</style>
</head>
<body>

<div class="auth-wrap">
  <h2>Artisan Login</h2>
  <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 16px;">
    Log in with the email and password NaijaFix admin sent you.
  </p>
  <div id="authMsg"></div>
  <input type="email" id="email" placeholder="Email address" />
  <input type="password" id="password" placeholder="Password" />
  <button id="submitBtn">Log In</button>
</div>

<script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore-compat.js"></script>
<script src="firebase-config.js"></script>
<script>
  const authMsg = document.getElementById("authMsg");
  const submitBtn = document.getElementById("submitBtn");

  // If already logged in, skip straight to dashboard
  auth.onAuthStateChanged(user => {
    if (user) window.location.href = "artisan-dashboard.html";
  });

  submitBtn.addEventListener("click", async () => {
    const email = document.getElementById("email").value.trim();
    const password = document.getElementById("password").value;
    authMsg.innerText = "";

    if (!email || !password) {
      authMsg.innerText = "Please fill in both fields.";
      return;
    }

    submitBtn.disabled = true;
    submitBtn.innerText = "Please wait...";

    try {
      await auth.signInWithEmailAndPassword(email, password);
      window.location.href = "artisan-dashboard.html";
    } catch (err) {
      authMsg.innerText = "Login failed — check your email and password, or contact NaijaFix admin.";
      console.error(err);
      submitBtn.disabled = false;
      submitBtn.innerText = "Log In";
    }
  });
</script>

</body>
</html>
